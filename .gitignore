.Rproj.user
.Rhistory
.RData
.Ruserdata
*.tar.gz
docs/

# raw model output: never committed. Only summaries and stamps.
validations/*/results/raw/
validations/*/results/plots/
# CMP_SMOKE=1 output: a throwaway end-to-end check, not evidence
validations/*/results/smoke/
# example-one-site.R output: a demonstration of the tier-3 flow, not evidence.
# The register's tier-3 claims come from 1,391 sub-sites, not from one.
validations/03-real-settings/results/example_*.csv
*.rds

# Tier 3 working documents: the diagnostic PDF is ~6 MB and redrawn from
# results/raw/ in minutes; its index is derived from the same pass. Both are for
# investigating a discrepancy, not evidence of one.
validations/03-real-settings/results/diagnostic_*

# Regenerated by every run.R invocation, which deletes it on start.
validations/*/results/progress.log
